---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'winsmux — Governance for AI agents on Windows',
  description = 'Windows-native control desk for AI coding agents: Claude Code, Codex, Antigravity, Grok Build, plus any OpenRouter or Colab-GPU model. Real panes, git worktree isolation, run compare, audit. One operator decides. Apache 2.0.',
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://winsmux.dev').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0D10" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, 'https://winsmux.dev').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sora_biz" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, 'https://winsmux.dev').toString()} />
  </head>
  <body class="bg-ws-bg text-ws-fg antialiased min-h-screen">
    <slot />
  </body>
</html>
