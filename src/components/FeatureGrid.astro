---
const features = [
  {
    title: 'Real terminal panes',
    body: 'Each agent runs in a real Windows Terminal pane. Read, send, interrupt, and check pane health — never a black box.',
    tone: 'accent',
    iconPaths: ['M4 17l6-6-6-6', 'M12 19h8'],
  },
  {
    title: 'Git worktree isolation',
    body: 'Every worker runs in its own git worktree, so parallel agents never overwrite each other. Managed-worktree is the default lifecycle.',
    tone: 'accent',
    iconPaths: ['M6 3v12', 'M18 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0', 'M6 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0', 'M18 9a9 9 0 0 1-9 9'],
  },
  {
    title: 'Any model, any provider',
    body: 'Claude Code, Codex, Antigravity, and Grok Build run as native CLI agents. Bring any OpenRouter model (GLM, Kimi, DeepSeek, Grok) or open-weight models on Colab GPUs.',
    tone: 'accent',
    iconPaths: ['M5 5h14v14H5z', 'M9 9h6v6H9z', 'M9 2v2', 'M15 2v2', 'M9 20v2', 'M15 20v2', 'M2 9h2', 'M2 15h2', 'M20 9h2', 'M20 15h2'],
  },
  {
    title: 'Read Guard',
    body: 'Operators read pane output before sending instructions. Every read is logged.',
    tone: 'accent',
    iconPaths: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
  },
  {
    title: 'One operator decides',
    body: 'Review comes back as evidence — findings, blocking state, verification. One human makes every final accept or reject.',
    tone: 'warn',
    iconPaths: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0', 'M16 11l2 2 4-4'],
  },
  {
    title: 'Compare runs',
    body: 'Compare recorded runs side by side. Shared changed files surface as hotspots with a risk badge before you pick a winner.',
    tone: 'accent',
    iconPaths: ['M16 3h5v5', 'M8 21H3v-5', 'M21 3l-7 7', 'M3 21l7-7'],
  },
  {
    title: 'DPAPI vault',
    body: 'Credentials stored with Windows DPAPI. Inject into a pane without exposing them to the transcript.',
    tone: 'accent',
    iconPaths: ['M3 11h18v11H3z', 'M7 11V7a5 5 0 0 1 10 0v4'],
  },
  {
    title: 'Audit trail',
    body: 'Structured end-of-run snapshots. No raw transcripts, no private paths.',
    tone: 'audit',
    iconPaths: ['M9 12l2 2 4-4', 'M21 12c0 1-1 11-9 11S3 13 3 12 4 1 12 1s9 10 9 11z'],
  },
  {
    title: 'Six worker slots',
    body: 'winsmux init creates six worker slots by default. The first is a Codex reviewer slot; the rest run your chosen backend.',
    tone: 'accent',
    iconPaths: ['M3 3h7v7H3z', 'M14 3h7v7h-7z', 'M14 14h7v7h-7z', 'M3 14h7v7H3z'],
  },
] as const;

const toneRing: Record<string, string> = {
  accent: 'ring-ws-accent/25 bg-ws-accent/[0.08] text-ws-accent',
  warn: 'ring-ws-accent-warn/25 bg-ws-accent-warn/[0.08] text-ws-accent-warn',
  audit: 'ring-ws-accent-audit/25 bg-ws-accent-audit/[0.08] text-ws-accent-audit',
};
---
<section id="features" class="px-4 md:px-8 pb-16 md:pb-32 max-w-[1200px] mx-auto">
  <div class="mb-10 md:mb-12">
    <div class="font-mono text-xs text-ws-accent uppercase tracking-[0.08em] mb-3">// what it does</div>
    <h2 class="text-2xl md:text-[32px] font-semibold tracking-tight m-0 max-w-[860px] leading-[1.2] text-balance">
      A control desk for multiple coding CLIs — with the human operator still in charge.
    </h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {features.map((f) => (
      <div class="bg-ws-bg-elevated border border-ws-border rounded-lg p-6 flex flex-col gap-3">
        <div class={`w-9 h-9 rounded-lg ring-1 flex items-center justify-center ${toneRing[f.tone]}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            {f.iconPaths.map((d) => (<path d={d} />))}
          </svg>
        </div>
        <div class="text-base md:text-lg font-semibold text-ws-fg tracking-tight">{f.title}</div>
        <div class="text-sm leading-relaxed text-ws-fg-secondary">{f.body}</div>
      </div>
    ))}
  </div>
</section>
