---
import { version } from '../lib/version';
const links = [
  { label: 'Docs', href: 'https://github.com/Sora-bluesky/winsmux/tree/main/docs' },
  { label: 'Models', href: '#providers' },
  { label: 'Architecture', href: 'https://github.com/Sora-bluesky/winsmux#why-it-exists' },
  { label: 'Approval', href: '#approval' },
  { label: 'Audit', href: '#features' },
  { label: 'GitHub', href: 'https://github.com/Sora-bluesky/winsmux' },
];
---
<nav class="sticky top-0 z-10 border-b border-ws-border bg-ws-bg/80 backdrop-blur-md">
  <div class="max-w-[1200px] mx-auto px-4 md:px-8 py-3.5 flex items-center gap-4 md:gap-8">
    <a href="/" class="flex items-baseline font-mono text-lg font-bold text-ws-fg tracking-tight no-underline shrink-0">
      winsmux<span class="text-ws-accent">_</span>
    </a>
    <div class="hidden md:flex gap-6 flex-1">
      {links.map(({ label, href }) => (
        <a
          href={href}
          class="text-ws-fg-secondary hover:text-ws-fg text-sm no-underline transition-colors"
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >{label}</a>
      ))}
    </div>
    <div class="ml-auto flex gap-2.5 items-center">
      <span class="hidden sm:inline font-mono text-[11px] text-ws-fg-muted uppercase tracking-[0.08em]">{version}</span>
      <a
        href="#install"
        class="bg-ws-accent text-ws-bg rounded px-4 py-2 text-[13px] font-semibold no-underline hover:opacity-90 transition-opacity"
      >Install</a>
    </div>
  </div>
</nav>
