---
---
<section id="approval" class="px-4 md:px-8 pb-16 md:pb-32 max-w-[1200px] mx-auto">
  <div class="mb-8">
    <div class="font-mono text-xs text-ws-accent uppercase tracking-[0.08em] mb-3">// how a run is judged</div>
    <h2 class="text-2xl md:text-[32px] font-semibold tracking-tight m-0 leading-[1.2] text-balance">
      One operator. Every decision backed by evidence.
    </h2>
  </div>
  <div class="bg-ws-bg-elevated border border-ws-border rounded-lg p-6 md:p-8 overflow-x-auto">
    <svg viewBox="0 0 1280 300" class="block w-full min-w-[860px] h-auto" role="img" aria-label="How a run is judged: an agent run in a real pane, isolated in a git worktree, review and verification evidence, compare runs with a risk badge, then the operator accepts or rejects — with an audit trail for every step.">
      <defs>
        <marker id="arrAccent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 Z" fill="#5EEAD4"/>
        </marker>
      </defs>

      <!-- flow arrows -->
      <path d="M 224 112 H 266" stroke="#5EEAD4" stroke-width="2" fill="none" marker-end="url(#arrAccent)"/>
      <path d="M 470 112 H 512" stroke="#5EEAD4" stroke-width="2" fill="none" marker-end="url(#arrAccent)"/>
      <path d="M 716 112 H 758" stroke="#5EEAD4" stroke-width="2" fill="none" marker-end="url(#arrAccent)"/>
      <path d="M 962 112 H 1004" stroke="#5EEAD4" stroke-width="2" fill="none" marker-end="url(#arrAccent)"/>

      <!-- 1. agent run -->
      <g>
        <rect x="24" y="70" width="196" height="84" rx="6" fill="#13161B" stroke="#3A4049" stroke-width="1.5"/>
        <text x="122" y="105" font-family="JetBrains Mono, monospace" font-size="13" fill="#E8E8EC" font-weight="600" text-anchor="middle">agent run</text>
        <text x="122" y="127" font-family="JetBrains Mono, monospace" font-size="11" fill="#9BA1AB" text-anchor="middle">real pane</text>
      </g>
      <text x="122" y="180" font-family="JetBrains Mono, monospace" font-size="11" fill="#6B7280" text-anchor="middle">Claude · Codex · Antigravity · Grok</text>

      <!-- 2. git worktree -->
      <g>
        <rect x="270" y="70" width="196" height="84" rx="6" fill="#13161B" stroke="#3A4049" stroke-width="1.5"/>
        <text x="368" y="105" font-family="JetBrains Mono, monospace" font-size="13" fill="#E8E8EC" font-weight="600" text-anchor="middle">git worktree</text>
        <text x="368" y="127" font-family="JetBrains Mono, monospace" font-size="11" fill="#9BA1AB" text-anchor="middle">isolated</text>
      </g>
      <text x="368" y="180" font-family="JetBrains Mono, monospace" font-size="11" fill="#6B7280" text-anchor="middle">managed by default</text>

      <!-- 3. review + verification -->
      <g>
        <rect x="516" y="70" width="196" height="84" rx="6" fill="#13161B" stroke="#3A4049" stroke-width="1.5"/>
        <text x="614" y="105" font-family="JetBrains Mono, monospace" font-size="13" fill="#E8E8EC" font-weight="600" text-anchor="middle">review</text>
        <text x="614" y="127" font-family="JetBrains Mono, monospace" font-size="11" fill="#9BA1AB" text-anchor="middle">+ verification</text>
      </g>
      <text x="614" y="180" font-family="JetBrains Mono, monospace" font-size="11" fill="#6B7280" text-anchor="middle">findings · blocking · verify</text>

      <!-- 4. compare runs -->
      <g>
        <rect x="762" y="70" width="196" height="84" rx="6" fill="#13161B" stroke="#3A4049" stroke-width="1.5"/>
        <text x="860" y="105" font-family="JetBrains Mono, monospace" font-size="13" fill="#E8E8EC" font-weight="600" text-anchor="middle">compare runs</text>
        <text x="860" y="127" font-family="JetBrains Mono, monospace" font-size="11" fill="#9BA1AB" text-anchor="middle">evidence</text>
      </g>
      <text x="860" y="180" font-family="JetBrains Mono, monospace" font-size="11" fill="#6B7280" text-anchor="middle">shared files · risk badge</text>

      <!-- 5. operator decides -->
      <g>
        <rect x="1008" y="70" width="196" height="84" rx="6" fill="rgba(251,191,36,0.18)" stroke="#FBBF24" stroke-width="2"/>
        <text x="1106" y="105" font-family="JetBrains Mono, monospace" font-size="13" fill="#FBBF24" font-weight="600" text-anchor="middle">operator</text>
        <text x="1106" y="127" font-family="JetBrains Mono, monospace" font-size="11" fill="#FBBF24" text-anchor="middle">decides</text>
      </g>
      <text x="1106" y="180" font-family="JetBrains Mono, monospace" font-size="11" fill="#6B7280" text-anchor="middle">accept / reject</text>

      <!-- audit trail -->
      <path d="M 24 244 H 1204" stroke="#86EFAC" stroke-width="1.25" stroke-dasharray="2 6" fill="none" opacity="0.7"/>
      <text x="24" y="266" font-family="JetBrains Mono, monospace" font-size="11" fill="#86EFAC">audit trail · structured snapshot for every step</text>
    </svg>
  </div>
</section>
